---
/**
 * The proposal: Chamber Content & Design Support.
 * All wording and numbers live in src/data/proposal.ts.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import SiteNav from "../components/SiteNav.astro";
import Card from "../components/Card.astro";
import Icon from "../components/Icon.astro";
import { ui } from "../lib/ui";
import { statTiles } from "../lib/charts";
import {
  INTRO, NOT_THIS, TILES, TERMS_NOTE, DELIVERABLES, DELIVERABLE_NOTES, VALUE_INTRO, RESOURCES, VALUE_NOTES,
  SCHEDULER, SETUP, REVISIONS, LEAD_INTRO, LEAD_INTRO_2, LEAD_TABLE, LEAD_RULES, RESPONSIBILITIES, OWNERSHIP,
  EXCLUDED, EXCLUSION_NOTES, ADDABLE, SOP, OWNERSHIP_ITEMS,
} from "../data/proposal";

const sections = [
  ["overview", "Overview"],
  ["deliverables", "Deliverables"],
  ["resources", "Included resources"],
  ["scheduling", "Scheduling tool"],
  ["setup", "Setup"],
  ["ownership", "Ownership and handoff"],
  ["revisions", "Revisions"],
  ["lead-times", "Lead times"],
  ["responsibilities", "Chamber responsibilities"],
  ["exclusions", "Exclusions"],
  ["process", "Delivery process"],
];
---

<BaseLayout
  title="Chamber Content and Design Support: Proposal"
  description="A proposal from MANY to the Montco Gateway Chamber of Commerce for newsletters, event graphics, promotional slides and short-form video."
  theme="many"
>
  <div class="mx-auto max-w-[1100px]">
    <SiteNav current="proposal" />
    <Header
      variant="many"
      eyebrow="Proposal · Montco Gateway Chamber × MANY"
      title="Chamber Content & Design Support"
      subtitle="Recurring creative production, off your plate, with posting and final approvals staying with you."
    />

    <nav class="sticky top-2 z-20 mb-6 flex gap-1 overflow-x-auto rounded-full border border-line bg-panel/85 p-1.5 shadow-md backdrop-blur" aria-label="On this page">
      {sections.map(([id, label]) => (
        <a href={`#${id}`} class="shrink-0 rounded-full px-3.5 py-1.5 text-[13px] font-semibold text-muted motion-safe:transition hover:bg-brand hover:text-brand-ink">{label}</a>
      ))}
    </nav>

    <div class="grid gap-[22px]">
      <Card id="overview" hero icon="file-text" tag="The proposal" title="What MANY would do for the chamber">
        {INTRO.map((p) => <p class={ui.p}>{p}</p>)}
        <div class={ui.note}><b>What this is, and isn't.</b> {NOT_THIS}</div>
        <div class="mt-4" set:html={statTiles(TILES)} />
        <div class={ui.note}><b>Terms.</b> {TERMS_NOTE}</div>
      </Card>

      <Card id="deliverables" icon="layers" tag="Monthly deliverables" title="What you receive each month" lede="Allowances are monthly maximums, scheduled across the calendar.">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-3">
          {DELIVERABLES.map((d) => (
            <div class={`${ui.mini} flex flex-col border-t-4 border-t-accent`}>
              <div class="flex items-center gap-2.5"><Icon name={d.icon} badge="md" /><h3 class={`${ui.h3} text-brand`}>{d.name}</h3></div>
              <div class="mt-3 flex items-baseline gap-2"><span class="font-display text-[40px] leading-none font-extrabold text-brand">{d.allowance}</span><span class="text-sm text-muted">{d.per}</span></div>
              <ul class="mt-3 grid list-disc gap-1.5 pl-[18px] text-[13px]">{d.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
        {DELIVERABLE_NOTES.map((n) => <p class={`${ui.foot} max-w-none`}>{n}</p>)}
      </Card>

      <Card id="resources" icon="gift" tag="Included value-adds" title="Resources for the chamber team" lede={VALUE_INTRO}>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(300px,1fr))] gap-3">
          {RESOURCES.map((r) => (
            <div class={`${ui.mini} border-t-4 border-t-accent`}>
              <div class="flex items-center gap-2.5"><Icon name={r.icon} badge="md" /><h3 class={`${ui.h3} text-brand`}>{r.name}</h3></div>
              <div class="mt-2.5 inline-flex items-center gap-1.5 rounded-full bg-chip px-2.5 py-0.5 text-xs font-semibold text-brand">Stated value: {r.value} · Included</div>
              {r.text.map((t) => <p class="mt-2.5 mb-0 text-[13px]">{t}</p>)}
            </div>
          ))}
        </div>
        {VALUE_NOTES.map((n, i) => <div class={i === 0 ? ui.note : `${ui.foot} max-w-none`}>{i === 0 ? <><b>{n.split(":")[0]}:</b>{n.slice(n.indexOf(":") + 1)}</> : n}</div>)}
      </Card>

      <Card id="scheduling" icon="calendar-check" tag="Included tool" title="Social media scheduling tool">
        {SCHEDULER.map((p) => <p class={ui.p}>{p}</p>)}
      </Card>

      <Card id="setup" icon="rocket" tag="Getting started" title="Setup within the monthly service">
        {SETUP.map((p) => <p class={ui.p}>{p}</p>)}
      </Card>

      <Card id="ownership" icon="shield-check" tag="Ownership and handoff" title="What the chamber keeps" lede="The work is built so the chamber can run it, now and in future engagements.">
        <ul class="m-0 grid list-none gap-3 p-0 min-[800px]:grid-cols-3">
          {OWNERSHIP_ITEMS.map((o) => (
            <li class={`${ui.mini} border-t-4 border-t-accent`}>
              <Icon name={o.icon} badge="md" />
              <h3 class={`${ui.h3} mt-2.5 mb-1.5 text-brand`}>{o.title}</h3>
              <p class="m-0 text-sm">{o.text}</p>
            </li>
          ))}
        </ul>
      </Card>

      <Card id="revisions" icon="repeat" tag="Revisions" title="Two consolidated rounds">
        <ul class="m-0 grid list-none gap-3 p-0 min-[700px]:grid-cols-2">
          {REVISIONS.map((r) => (
            <li class={`${ui.mini} flex items-start gap-3`}><Icon name={r.icon} badge="md" /><span class="text-sm">{r.text}</span></li>
          ))}
        </ul>
      </Card>

      <Card id="lead-times" icon="clock" tag="Lead times and approvals" title="Plan backward from first use">
        <p class={ui.p}>{LEAD_INTRO}</p>
        <p class={ui.p}>{LEAD_INTRO_2}</p>
        <div class="mt-3 grid gap-3 min-[640px]:hidden">
          {LEAD_TABLE.map(([w, sub, tgt]) => (
            <div class={ui.mini}>
              <h3 class={`${ui.h3} text-brand`}>{w}</h3>
              <div class="mt-2 text-[11px] font-semibold tracking-[.06em] text-muted uppercase">Required submission timing</div>
              <p class="m-0 mb-2 text-sm">{sub}</p>
              <div class="text-[11px] font-semibold tracking-[.06em] text-muted uppercase">First-draft target</div>
              <p class="m-0 text-sm">{tgt}</p>
            </div>
          ))}
        </div>
        <div class={`${ui.tableWrap} mt-3 max-[639px]:hidden`}>
          <table class={ui.table}>
            <thead><tr><th class={ui.th}>Work type</th><th class={ui.th}>Required submission timing</th><th class={ui.th}>First-draft target</th></tr></thead>
            <tbody>
              {LEAD_TABLE.map(([w, s, t]) => <tr><td class={`${ui.td} font-semibold`}>{w}</td><td class={ui.td}>{s}</td><td class={ui.td}>{t}</td></tr>)}
            </tbody>
          </table>
        </div>
        <ul class={`${ui.list} mt-4 max-w-none`}>{LEAD_RULES.map((r) => <li>{r}</li>)}</ul>
      </Card>

      <Card id="responsibilities" icon="user-check" tag="Working together" title="Chamber responsibilities" lede="The chamber will provide:">
        <ul class="m-0 grid list-none gap-2.5 p-0">
          {RESPONSIBILITIES.map((r) => <li class="flex items-start gap-2.5 text-sm"><Icon name="check-circle" class="mt-0.5 size-[18px] text-brand" />{r}</li>)}
        </ul>
        <div class={ui.note}>{OWNERSHIP}</div>
      </Card>

      <Card id="exclusions" icon="x-circle" tag="Exclusions and allowance rules" title="What the monthly fee does not include">
        <p class={ui.p}>The monthly fee does not include:</p>
        <ul class="m-0 mb-4 flex list-none flex-wrap gap-2 p-0">
          {EXCLUDED.map((e) => <li class="rounded-full border border-line bg-chip px-3 py-1 text-[13px]">{e}</li>)}
        </ul>
        <div class="mb-4 flex items-start gap-3 rounded-xl border border-accent/40 bg-brass-soft px-4 py-3 text-sm">
          <Icon name="plus-circle" class="mt-0.5 size-5 text-brass" />
          <span><b>{ADDABLE.split(". ")[0]}.</b> {ADDABLE.split(". ").slice(1).join(". ")}</span>
        </div>
        {EXCLUSION_NOTES.map((n) => <p class={`${ui.p} max-w-none text-sm`}>{n}</p>)}
      </Card>

      <Card id="process" icon="list-checks" tag="How the work runs" title="Proposed internal delivery SOP">
        <ol class="m-0 grid list-none gap-3 p-0 min-[800px]:grid-cols-2">
          {SOP.map((s, i) => (
            <li class={ui.mini}>
              <div class="flex items-center gap-2.5"><Icon name={s.icon} badge="md" /><h3 class={ui.h3}><span class="mr-1.5 rounded bg-chip px-1.5 py-px font-mono text-[11px] text-brand">{i + 1}</span>{s.title}</h3></div>
              {s.text.map((t) => <p class="mt-2.5 mb-0 text-[13px]">{t}</p>)}
              {s.list && <ul class="mt-2 grid list-disc gap-1 pl-[18px] text-[13px]">{s.list.map((l) => <li>{l}</li>)}</ul>}
            </li>
          ))}
        </ol>
      </Card>
    </div>

    <section class="relative mt-[22px] overflow-hidden rounded-3xl bg-gradient-to-br from-[#0a255c] via-[#0c2d6e] to-[#0a255c] p-6 text-white shadow-xl ring-1 ring-white/10 sm:p-9" aria-labelledby="closing-title">
      <div class="pointer-events-none absolute -top-20 -left-16 h-64 w-64 rounded-full bg-[#29a37a]/25 blur-3xl" aria-hidden="true"></div>
      <div class="relative grid items-center gap-8 min-[820px]:grid-cols-[minmax(0,1fr)_minmax(0,380px)]">
        <div>
          <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1 text-xs font-semibold tracking-[.2em] text-[#5ee0c0] uppercase ring-1 ring-white/20">
            <span class="size-1.5 rounded-full bg-[#5ee0c0]" aria-hidden="true"></span>
            MANY · Marketing Agency Near You
          </div>
          <h2 id="closing-title" class="mt-3 font-display text-[clamp(26px,4vw,40px)] leading-[1.1] font-extrabold tracking-tight text-balance">Ready when you are.</h2>
          <p class="mt-3 max-w-[46ch] font-serif text-[clamp(18px,2.2vw,22px)] leading-snug text-[#bdeedd] italic">
            Recurring creative production, with a shared calendar, templates the chamber keeps, and posting and approvals staying with Jude.
          </p>
          <p class="mt-4 text-sm text-white/75">Prepared for the Montco Gateway Chamber of Commerce. Term: January 1 through December 31, 2027.</p>
        </div>
        <img
          src="/assets/many-collage.webp"
          alt="Collage of the MANY team at community events and recording video"
          width="768"
          height="768"
          loading="lazy"
          class="mx-auto block h-auto w-full max-w-[380px] drop-shadow-2xl"
        />
      </div>
    </section>

    <p class="mt-6 text-center text-xs text-muted">
      Looking for the research behind this?
      <a class="font-semibold text-brand underline underline-offset-2" href="/audit">See the audit and growth plan</a>.
    </p>
  </div>
</BaseLayout>
