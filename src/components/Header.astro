---
/**
 * Page header. Two variants:
 *  - "montco": the audit and checklist (orange wash, Montco logo, optional progress bar).
 *  - "many":   the proposal (navy hero, Montco and MANY logos side by side).
 *
 * MANY logo: drop a dark-on-light file at public/assets/many-logo.svg (or .png / .webp).
 * Until one exists, a plain text "MANY" is shown in its place.
 */
import fs from "node:fs";
import path from "node:path";

interface Props {
  variant?: "montco" | "many";
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  progress?: boolean;
}
const {
  variant = "montco",
  eyebrow = "Montco Gateway Chamber × MANY · October 20, 2026",
  title = "Growing the Gateway",
  subtitle = "What we found, what we would do about it, and a plan that fills in as we learn your numbers.",
  progress = false,
} = Astro.props;

const manyLogo = ["svg", "png", "webp"]
  .map((ext) => `many-logo.${ext}`)
  .find((f) => fs.existsSync(path.join(process.cwd(), "public", "assets", f)));
---

{
  variant === "many" ? (
    <header class="relative mb-6 overflow-hidden rounded-3xl bg-gradient-to-br from-[#0a255c] via-[#0c2d6e] to-[#0a255c] px-6 pt-6 pb-8 text-white shadow-xl ring-1 ring-white/10 sm:px-9 sm:pt-8 sm:pb-10">
      <!-- soft emerald glow and a faint ring, echoing the proposal template -->
      <div class="pointer-events-none absolute -top-24 -right-16 h-72 w-72 rounded-full bg-[#29a37a]/25 blur-3xl" aria-hidden="true" />
      <div class="pointer-events-none absolute -right-24 -bottom-28 h-80 w-80 rounded-full border-[28px] border-white/[.04]" aria-hidden="true" />

      <div class="relative inline-flex flex-wrap items-center gap-x-5 gap-y-3 rounded-2xl bg-white px-5 py-3 shadow-lg">
        <img
          src="/assets/logo-dark-text.webp"
          alt="Montco Gateway Chamber of Commerce"
          width="800"
          height="232"
          class="block h-[clamp(36px,6vw,52px)] w-auto"
        />
        <span class="text-xl font-light text-slate-300" aria-hidden="true">×</span>
        {manyLogo ? (
          <img src={`/assets/${manyLogo}`} alt="MANY: Marketing Agency Near You" width="1584" height="396" class="block h-[clamp(38px,6vw,54px)] w-auto" />
        ) : (
          <span class="font-display text-[clamp(26px,4.4vw,36px)] leading-none font-extrabold tracking-tight text-[#0a255c]">MANY</span>
        )}
      </div>

      <div class="relative mt-7">
        <div class="inline-flex items-center gap-2 rounded-full bg-white/10 px-3.5 py-1 text-xs font-semibold tracking-[.2em] text-[#5ee0c0] uppercase ring-1 ring-white/20">
          <span class="size-1.5 rounded-full bg-[#5ee0c0] motion-safe:animate-pulse" aria-hidden="true" />
          {eyebrow}
        </div>
        <h1 class="mt-3 max-w-[22ch] font-display text-[clamp(30px,5vw,52px)] leading-[1.05] font-extrabold tracking-tight text-balance">
          {title}
        </h1>
        <p class="mt-3 max-w-[48ch] font-serif text-[clamp(19px,2.4vw,24px)] leading-snug text-[#bdeedd] italic">
          {subtitle}
        </p>
      </div>
    </header>
  ) : (
    <header class="relative mb-6 flex flex-wrap items-end justify-between gap-x-6 gap-y-4 overflow-hidden rounded-2xl border border-accent/30 bg-gradient-to-br from-accent/15 via-panel to-panel px-6 pt-6 pb-5 shadow-[0_1px_2px_rgb(0_0_0/.04)]">
      <!-- decorative arch, echoing the logo mark -->
      <svg class="pointer-events-none absolute -top-6 -right-6 h-44 w-44 text-accent opacity-[.08]" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
        <path fill="currentColor" d="M0 0h100v100H72V62a22 22 0 0 0-44 0v38H0z" />
      </svg>
      <div class="relative">
        <picture class="mb-3.5 block">
          <source srcset="/assets/logo-light-text.webp" media="(prefers-color-scheme: dark)" />
          <img
            src="/assets/logo-dark-text.webp"
            alt="Montco Gateway Chamber of Commerce"
            width="800"
            height="232"
            class="block h-[clamp(44px,7vw,64px)] w-auto"
          />
        </picture>
        <div class="inline-flex items-center gap-2 rounded-full bg-chip px-3 py-1 text-xs font-semibold tracking-[.12em] text-brand uppercase">
          {eyebrow}
        </div>
        <h1 class="mt-2 font-display text-[clamp(28px,4.4vw,42px)] leading-[1.1] font-bold text-balance">
          {title}
        </h1>
        <p class="mt-1.5 max-w-[60ch] text-muted">
          {subtitle}
        </p>
      </div>
      {
        progress && (
          <div class="relative min-w-[200px] flex-[0_1_260px]" aria-live="polite" id="progWrap" hidden>
            <small class="text-xs text-muted" id="progLabel">0 of 0 blanks filled</small>
            <div class="mt-1.5 h-2 overflow-hidden rounded bg-line">
              <span class="block h-full w-0 bg-accent transition-[width] duration-300" id="progBar" />
            </div>
          </div>
        )
      }
    </header>
  )
}
