---
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

const tabs: { id: string; panel: string; icon: IconName; label: string }[] = [
  { id: "findings", panel: "findings", icon: "search", label: "What we found" },
  { id: "approach", panel: "approach", icon: "compass", label: "What we would do" },
  { id: "plan", panel: "planTab", icon: "clipboard-check", label: "Your plan" },
];
---

<nav class="mb-[22px] flex flex-wrap gap-2" role="tablist" aria-label="Sections">
  {
    tabs.map((t) => (
      <button
        role="tab"
        id={`t-${t.id}`}
        aria-controls={t.panel}
        data-tab={t.panel}
        class="flex items-center gap-2 rounded-full border border-line bg-panel px-4 py-2 font-display text-[15px] font-medium text-muted motion-safe:transition hover:border-accent/60 hover:text-ink aria-selected:border-brand aria-selected:bg-brand aria-selected:font-bold aria-selected:text-brand-ink"
      >
        <Icon name={t.icon} class="size-[18px]" />
        {t.label}
      </button>
    ))
  }
</nav>
