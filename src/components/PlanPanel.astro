---
import Card from "./Card.astro";
import Field from "./Field.astro";
import { ui } from "../lib/ui";

const legend = "mb-2 flex items-center gap-2 p-0 font-display text-sm font-bold text-brand";
const legendN = "rounded bg-chip px-1.5 py-px font-mono text-[11px] font-normal text-brand";
const fieldset = "m-0 mt-[18px] min-w-0 border-0 p-0";
const row2 = "grid grid-cols-2 gap-2.5";
---

<div id="planTab" role="tabpanel" aria-labelledby="t-plan" class="grid gap-[22px]" hidden>
  <Card
    tag="Once we have your answers"
    title="Your plan"
    lede="Fill in the blanks on the left. The plan on the right updates with your numbers: the opportunity, the first 90 days, who does the work, and how we'd start."
  />

  <div class="grid grid-cols-1 items-start gap-7 min-[901px]:grid-cols-[minmax(0,380px)_minmax(0,1fr)]">
    <aside
      class="overflow-auto rounded-[10px] border border-line bg-panel p-[18px] min-[901px]:sticky min-[901px]:top-[calc(env(safe-area-inset-top)+12px)] min-[901px]:max-h-[calc(100vh-24px)]"
      aria-label="Fill in the blanks"
    >
      <div class="mb-1.5 flex flex-wrap items-center justify-between gap-2">
        <h2 class="font-display text-lg leading-[1.15] font-bold">Fill in the blanks</h2>
        <div class={ui.btns}>
          <button class={ui.btn} id="sampleBtn" type="button">Try sample numbers</button>
          <button class={ui.btn} id="clearBtn" type="button">Clear</button>
        </div>
      </div>
      <p class="m-0 text-xs text-muted">Estimates are fine. Leave anything blank you don't know yet.</p>

      <form id="sheet" autocomplete="off">
        <fieldset class={fieldset}>
          <legend class={legend}><span class={legendN}>0</span>Strategic plan</legend>
          <Field id="surveyThemes" kind="textarea" label="What did the strategic planning survey surface?" placeholder="e.g., Members value the people, but don't see the chamber as essential" hint="The board and stakeholder survey closed October 10" />
          <Field id="planFocus" kind="select" label="Grow membership, or solve business problems?" options={[["grow", "Grow membership"], ["solve", "Solve business problems"], ["both", "Both, in that order: solve, then grow"]]} />
          <Field id="mustBelong" label={'"I\'d be crazy not to belong because…"'} placeholder="e.g., It's where my next three clients come from" />
        </fieldset>

        <fieldset class={fieldset}>
          <legend class={legend}><span class={legendN}>1</span>Goals</legend>
          <Field id="goal" kind="textarea" label="What does a great 2027 look like?" placeholder="e.g., Grow to 450 members and add 3 Annual Partners" />
          <Field id="urgent" label="What's on your desk right now?" placeholder="e.g., Holiday luncheon invites" />
        </fieldset>

        <fieldset class={fieldset}>
          <legend class={legend}><span class={legendN}>2</span>Members</legend>
          <div class={row2}>
            <Field id="members" type="number" min={0} label="Members today" />
            <Field id="dues" type="number" min={0} label="Average dues ($)" />
          </div>
          <div class={row2}>
            <Field id="retention" type="number" min={0} max={100} label="Renewal rate (%)" />
            <Field id="newPerYear" type="number" min={0} label="New members / year" />
          </div>
          <Field id="firstYear" type="number" min={0} max={100} label="First-year renewal rate (%)" hint="How many first-year members renew for year two" />
        </fieldset>

        <fieldset class={fieldset}>
          <legend class={legend}><span class={legendN}>3</span>Events</legend>
          <div class={row2}>
            <Field id="events" type="number" min={0} label="Events / year" />
            <Field id="guests" type="number" min={0} step={0.5} label="Non-member guests / event" />
          </div>
          <Field id="guestConv" type="number" min={0} max={100} step={0.5} label="Guests who join today (%)" />
        </fieldset>

        <fieldset class={fieldset}>
          <legend class={legend}><span class={legendN}>4</span>Sponsors</legend>
          <div class={row2}>
            <Field id="partners" type="number" min={0} label="Annual Partners" />
            <Field id="partnerPrice" type="number" min={0} label="Avg. partner value ($)" />
          </div>
          <Field id="partnerRenew" type="number" min={0} max={100} label="Partners who renew (%)" />
        </fieldset>

        <fieldset class={fieldset}>
          <legend class={legend}><span class={legendN}>5</span>Team &amp; email</legend>
          <div class={row2}>
            <Field id="staff" type="number" min={0} step={0.5} label="Paid staff" />
            <Field id="volunteers" type="number" min={0} label="Active volunteers" />
          </div>
          <div class={row2}>
            <Field id="listSize" type="number" min={0} label="Email list size" />
            <Field id="openRate" type="number" min={0} max={100} step={0.1} label="Open rate (%)" />
          </div>
        </fieldset>

        <fieldset class={fieldset}>
          <legend class={legend}><span class={legendN}>6</span>Council &amp; decisions</legend>
          <Field id="council" kind="select" label="Marketing Advisory Council status" options={[["active", "Active, meets regularly"], ["advisory", "Meets, but advisory only"], ["dormant", "Dormant"]]} />
          <Field id="pastAgency" kind="textarea" label="Past agency or freelancer experience" placeholder="e.g., Hired a freelancer in 2024; ended after 6 months; nothing left behind" hint="How long it lasted, why it ended, what's still in use" />
          <Field id="foundingPartners" label="Founding partner agencies" placeholder="Names, once confirmed" />
          <Field id="budget" kind="select" label="How would this be funded?" options={[["cash", "Budget line in 2027"], ["board", "One-time board approval"], ["sponsor", "Sponsor-underwritten"], ["trade", "Annual Partner trade"], ["unsure", "Not sure yet"]]} />
          <div class={row2}>
            <Field id="signoff" label="Who signs off?" placeholder="e.g., Executive committee" />
            <Field id="boardDate" label="Board finalizes 2027 by" placeholder="e.g., Mid-November" />
          </div>
        </fieldset>
      </form>
    </aside>

    <!-- Rendered live by src/scripts/plan.ts -->
    <main class="grid min-w-0 gap-[22px]" id="plan" aria-live="polite"></main>
  </div>
</div>
