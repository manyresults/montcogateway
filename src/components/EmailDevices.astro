---
/**
 * A staggered fan of three phones showing the chamber's current emails.
 * Pure CSS/HTML (no image of a phone), so it stays crisp and works in light
 * and dark mode. The phones run off the bottom and fade out ("feathered").
 *
 * Screens: public/assets/email-newsletter.webp, email-holiday.webp,
 * email-networking.webp (combined from the chamber's email screenshots).
 */
interface Phone {
  src: string;
  alt: string;
  /** Position/size as % of the container, plus tilt. */
  style: string;
  z: number;
}

const phones: Phone[] = [
  {
    src: "/assets/email-holiday.webp",
    alt: "The chamber's Holiday Mingle and Jingle Luncheon invitation email, shown on a phone",
    style: "left:4%;top:15%;width:29%;transform:rotate(-6deg)",
    z: 10,
  },
  {
    src: "/assets/email-newsletter.webp",
    alt: "The chamber's October Events At a Glance newsletter, shown on a phone",
    style: "left:33.5%;top:0%;width:33%",
    z: 20,
  },
  {
    src: "/assets/email-networking.webp",
    alt: "The chamber's Networking at Noon event email, shown on a phone",
    style: "left:67%;top:15%;width:29%;transform:rotate(6deg)",
    z: 10,
  },
];
---

<figure class="m-0" id="email-devices">
  <div
    class="relative mx-auto aspect-[820/470] w-full max-w-[820px] [mask-image:linear-gradient(to_bottom,#000_0%,#000_58%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,#000_0%,#000_58%,transparent_100%)]"
    role="group"
    aria-label="Three phones showing the chamber's newsletter and event emails"
  >
    {
      phones.map((p) => (
        <div class="absolute" style={`${p.style};z-index:${p.z}`}>
          <div class="relative aspect-[9/19.2] rounded-[11%/5.2%] bg-[#0b1020] p-[3.4%] shadow-[0_34px_60px_-24px_rgb(2_8_23/.55),inset_0_0_0_2px_#2b3550]">
            <!-- side buttons -->
            <span class="absolute top-[17%] -left-[1.3%] h-[5%] w-[1.3%] rounded-l bg-[#1b2440]" aria-hidden="true" />
            <span class="absolute top-[25%] -left-[1.3%] h-[9%] w-[1.3%] rounded-l bg-[#1b2440]" aria-hidden="true" />
            <span class="absolute top-[24%] -right-[1.3%] h-[12%] w-[1.3%] rounded-r bg-[#1b2440]" aria-hidden="true" />
            <div class="relative h-full w-full overflow-hidden rounded-[8.4%/4%] bg-[#eef1f5]">
              <img src={p.src} alt={p.alt} width="540" class="mt-[9.5%] block h-auto w-full" loading="lazy" />
              <!-- camera island and a soft glass sheen -->
              <span class="absolute top-[1.6%] left-1/2 h-[2.4%] w-[28%] -translate-x-1/2 rounded-full bg-[#05070d]" aria-hidden="true" />
              <span class="pointer-events-none absolute inset-0 bg-gradient-to-br from-white/10 via-transparent to-transparent" aria-hidden="true" />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</figure>
