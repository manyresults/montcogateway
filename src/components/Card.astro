---
import { ui } from "../lib/ui";
import Icon from "./Icon.astro";
import type { IconName } from "../lib/icons";

interface Props {
  tag: string;
  title: string;
  lede?: string;
  icon?: IconName;
  /** Larger, tinted card for the first card on a page. */
  hero?: boolean;
  class?: string;
}
const { tag, title, lede, icon, hero, class: extra } = Astro.props;
---

<section
  class:list={[
    ui.card,
    hero && "border-accent/30 bg-gradient-to-br from-accent/10 via-panel to-panel",
    extra,
  ]}
>
  <div class="mb-1 flex items-start gap-3">
    {icon && <Icon name={icon} badge={hero ? "lg" : "md"} />}
    <div class="min-w-0">
      <span class={ui.tag}>{tag}</span>
      <h2 class:list={[ui.h2, hero && "text-[clamp(24px,3.2vw,30px)]"]}>{title}</h2>
    </div>
  </div>
  {lede && <p class={ui.lede}>{lede}</p>}
  <slot />
</section>
