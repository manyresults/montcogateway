---
/**
 * BaseLayout.astro — HTML shell: meta, fonts, global styles.
 * The page is deliberately noindex (see also vercel.json and robots.txt).
 */
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** "montco" (default, orange) or "many" (navy and emerald, for the proposal). */
  theme?: "montco" | "many";
}
const { title, description, theme = "montco" } = Astro.props;
const fonts =
  theme === "many"
    ? "family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600&family=EB+Garamond:ital,wght@1,400;1,500&family=IBM+Plex+Mono:wght@400;500"
    : "family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,700&family=Public+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=EB+Garamond:ital,wght@1,400;1,500";
---

<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === "many" ? "#0a255c" : "#f24f02"} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`}
    />
    <title>{title}</title>
  </head>
  <body class="px-4 pt-[env(safe-area-inset-top)] pb-[calc(env(safe-area-inset-bottom)+48px)] print:p-0">
    <slot />
  </body>
</html>
